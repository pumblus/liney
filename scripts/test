#!/usr/bin/env bash
# Run LineyTests on the QA simulators, logging to .build/agent-logs/.
#
#   scripts/test                      all suites, iPhone
#   scripts/test StorageFullTests ... named suites (or Suite/testName), iPhone
#   scripts/test --all                all suites, iPhone, iPad, then iPhone Duo
#   scripts/test --duo [suites ...]   all or named suites, iPhone Duo (iOS 27.1)
#   scripts/test --remove-slots       delete every slot clone
#
# Simulators are found by name ("Liney OS27 iPhone QA", "Liney OS27 iPad QA",
# "Liney OS27 Duo QA"). With LINEY_SIM_SLOT=<n>, runs use "Liney Agent <n> iPhone",
# "... iPad", and "... Duo", cloned from the QA simulators on first use, so parallel
# worktrees never share a simulator. LINEY_IPHONE_SIM / LINEY_IPAD_SIM /
# LINEY_DUO_SIM set to a simulator UDID override both.
set -uo pipefail
cd "$(dirname "$0")/.."

devices=(iphone)
only=()
for arg in "$@"; do
  case "$arg" in
    --all) devices=(iphone ipad duo) ;;
    --duo) devices=(duo) ;;
    --remove-slots)
      xcrun simctl list devices | grep -F 'Liney Agent ' | grep -oE '[0-9A-F-]{36}' |
        while read -r id; do xcrun simctl delete "$id"; done
      exit 0 ;;
    -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "unknown option: $arg" >&2; exit 2 ;;
    *) only+=("-only-testing:LineyTests/$arg") ;;
  esac
done
if [[ ${#only[@]} -gt 0 && ${#devices[@]} -gt 1 ]]; then
  echo "--all runs every suite; drop the suite names" >&2; exit 2
fi

find_sim() {
  xcrun simctl list devices available | grep -F "$1 (" | head -1 | grep -oE '[0-9A-F-]{36}'
}

udid() {
  local override=$1 qa=$2 kind=$3
  if [[ -n "${!override:-}" ]]; then echo "${!override}"; return; fi
  if [[ -z "${LINEY_SIM_SLOT:-}" ]]; then find_sim "$qa"; return; fi
  local name="Liney Agent $LINEY_SIM_SLOT $kind" id source
  id=$(find_sim "$name")
  if [[ -z "$id" ]] && source=$(find_sim "$qa") && [[ -n "$source" ]]; then
    id=$(xcrun simctl clone "$source" "$name") || echo "$kind: clone failed; shut down \"$qa\" and retry" >&2
  fi
  echo "$id"
}

mkdir -p .build/agent-logs
stamp=$(date +%Y%m%d-%H%M%S)
status=0
for device in "${devices[@]}"; do
  case "$device" in
    iphone) id=$(udid LINEY_IPHONE_SIM "Liney OS27 iPhone QA" iPhone) ;;
    ipad) id=$(udid LINEY_IPAD_SIM "Liney OS27 iPad QA" iPad) ;;
    duo) id=$(udid LINEY_DUO_SIM "Liney OS27 Duo QA" Duo) ;;
  esac
  if [[ -z "$id" ]]; then
    echo "$device: no QA simulator; create one or set its LINEY_*_SIM override" >&2
    status=1; continue
  fi
  log=.build/agent-logs/test-$device-$stamp.log
  # Runs share one derived-data path, so they must stay serial.
  xcodebuild test -project Liney.xcodeproj -scheme Liney \
    -destination "platform=iOS Simulator,id=$id" -derivedDataPath .build/os27 \
    -parallel-testing-enabled NO -collect-test-diagnostics never CODE_SIGNING_ALLOWED=NO \
    ${only[@]+"${only[@]}"} >"$log" 2>&1
  code=$?
  echo "$device: exit $code, log $log"
  grep -E "Executed [0-9]+ tests?, with" "$log" | tail -1
  grep -E "Test run with [0-9]+ tests?" "$log" | tail -1
  grep -E ": error: |error: -\[|✘" "$log" | sort -u | head -20
  # A failure on one device is enough to report; skip the remaining runs.
  [[ $code -eq 0 ]] || { status=$code; break; }
done
exit $status
