    "Photos are saved directly in Liney, so your entries remain intact even if deleted from Photos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are saved directly in Liney, so your entries remain intact even if deleted from Photos."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "加入的相片會另外儲存在 Liney 中，即使從「相片」App 刪除也不影響日記。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加的照片会单独保存在 Liney 中，即使系统相册删除照片也不影响日记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入的照片會另外儲存在 Liney 中，即使從「照片」App 刪除也不影響日記。"
          }
        }
      }
    },
    "Data is only imported or exported when you choose to do so.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data is only imported or exported when you choose to do so."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你主動操作時才會匯入或匯出，絕不會在背景自動上傳。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你主动操作时进行导入与导出，绝不会在后台自动上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你主動操作時才會匯入或匯出，絕不會在背景自動上傳。"
          }
        }
      }
    }
  },
  "version": "1.0"
}